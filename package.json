{
  "name": "workspace",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "services:up": "docker compose up -d --wait && ./scripts/garage-provision.sh",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v",
    "services:logs": "docker compose logs -f",
    "services:nix": "nix run .#services"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.14.0"
}
