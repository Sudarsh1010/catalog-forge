# Local development services — see README ("Development services").
# Works identically against both variants:
#   docker compose:  pnpm services:up
#   nix:             nix run .#services
#
# For the Next.js app, copy to platform/app/.env.local (Next.js only loads env
# files from the app directory):
#   cp .env.example platform/app/.env.local

# Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/catalog_forge

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Garage (S3-compatible object storage) — must match scripts/garage-provision.sh
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=catalog-forge
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=941431a5c0f40a678c1ecf010982a2a23f9536ada8d3893cd0641d78ac6cf53c
S3_FORCE_PATH_STYLE=true
